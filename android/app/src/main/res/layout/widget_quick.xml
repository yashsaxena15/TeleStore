<?xml version="1.0" encoding="utf-8"?>
<!-- TeleStore on the home screen: storage used and four quick actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="38dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_symbol" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_upload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Upload"
                android:src="@drawable/ic_widget_upload" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Upload"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Add link"
                android:src="@drawable/ic_widget_link" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Add link"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_photos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Photos"
                android:src="@drawable/ic_widget_photos" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Photos"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_widget_search" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Search"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
