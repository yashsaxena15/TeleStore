# ==============================================================================
# TeleStore - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values for your deployment.

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=TeleStore
TIME_ZONE=+05:30
PORT=8000
HOST=0.0.0.0

# Public or domain URL of the web server (leave empty or set for reverse proxy)
WEB_APP=http://localhost:8000

# REQUIRED. Signs login cookies and protects Vault recovery. The app will not start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me

# ------------------------------------------------------------------------------
# 2. Telegram API Credentials
# ------------------------------------------------------------------------------
# Obtain your API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# Telegram numerical user ID of the primary owner / super-admin
OWNER=1234567890

# ------------------------------------------------------------------------------
# 3. Telegram Bot Tokens (Worker Pool)
# ------------------------------------------------------------------------------
# TOKEN0 is the primary bot. Add TOKEN1, TOKEN2... up to TOKEN19 to scale
# concurrent streaming and download speeds across multiple worker bots.
LOGGER_BOT=1245345768:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOKEN0=1245345768:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TOKEN1=1245345769:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TOKEN2=1245345770:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Telegram Storage & Log Channels
# ------------------------------------------------------------------------------
# Numerical channel/group IDs where media files and logs are stored.
# (Usually starts with -100 for supergroups/channels)
LOGS=-1001235354346
MOVIE=-1001235354346
MOVIE_GRP=-1001235354346
FILTER_CHAT=-1001234567890
LEECH_SOURCE=-1001234567890
LEECH_CHAT=-1001234567890

# ------------------------------------------------------------------------------
# 5. Database Connection
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://mongo:27017 for Docker, or MongoDB Atlas URI)
DATABASE_URL=mongodb://mongo:27017/TelegramFileServer

# ------------------------------------------------------------------------------
# 6. Admin Authentication & Access Control
# ------------------------------------------------------------------------------
# Fallback login, used only when this username is not in MongoDB.
# REQUIRED: at least 12 characters; "password"/"admin" are refused at startup.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Authorized Admin Emails for Google OAuth (comma-separated)
AUTHORIZED_ADMIN_EMAILS=admin@example.com,user1@example.com

# ------------------------------------------------------------------------------
# 7. Google OAuth Configuration (Optional)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 8. SMTP Email Service (Optional - for Vault PIN Reset OTPs)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ------------------------------------------------------------------------------
# 9. Distributed Workers & Multi-Node Settings (Optional)
# ------------------------------------------------------------------------------
# REQUIRED. Authenticates worker nodes on /api/worker (workers receive bot tokens).
# Use the same value as WORKER_KEY on each worker.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SECRET_KEY=change-me

# Optional. Secret for the GitHub auto-update webhook (POST /system/github).
# Leave empty to disable the webhook; otherwise use the same value in GitHub → Settings → Webhooks.
GITHUB_WEBHOOK_SECRET=

# Max concurrent transfers processed locally on the Master node (default: 1)
# (Leave remaining tasks in queue for distributed worker nodes to claim)
MAX_LOCAL_CONCURRENT=1

# Minimum file size in MB to trigger multi-range parallel splitting (default: 1950)
MULTI_RANGE_MIN_SIZE_MB=1950

# Target part size in MB for parallel multi-range chunks (default: 1950)
MULTI_RANGE_PART_SIZE_MB=1950